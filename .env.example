# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
# Shared secret the API route sends with each submission. Generate a long
# random value and set the same value in the Convex deployment's env vars.
CONTACT_FORM_SECRET=

# Resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@bicyclelondon.com
JOBS_TO_EMAIL=jobs@bicyclelondon.com

# Site
NEXT_PUBLIC_SITE_URL=https://www.bicyclelondon.com

# Mux (TOKEN_ID/SECRET only needed locally to upload via scripts/mux-upload.mjs)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
NEXT_PUBLIC_MUX_ENV_KEY=

# Sentry (error monitoring). SENTRY_ORG/PROJECT/AUTH_TOKEN only for source maps.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
